{
  // webnovel-writer 的 OpenCode 配置。
  //
  // ⚠️ 故意**不**写 "$schema": "https://opencode.ai/config.json"。
  // 已实测（2026-10-01）：该地址返回的仍是 **V1 形状**的 schema——顶层
  // additionalProperties: false，且只认 permission / agent / command / plugin /
  // snapshot / attachment / provider 这些 V1 字段，文档里的 V2 原生字段
  // permissions / agents / commands / plugins / snapshots / media / warming /
  // update / providers 一个都没有。挂上去只会让编辑器把**正确的** V2 字段
  // 全标红。schema 声称自己"is the source of truth"，这句在这一点上目前不成立。

  // 显式放行 agent 日常需要的只读工具，并保留 write-guard 的边界。
  // 说明：6 个子 agent 各自在 .opencode/agents/*.md 里有 deny-all + allowlist，
  // 那才是真正收紧工具集的地方；这里的全局规则只约束**主 agent**（用户直接
  // 对话的那个），V2 默认策略是 allow-all。
  "permissions": [
    { "action": "*", "resource": "*", "effect": "allow" },
    // 书项目在 E:\workspace\webnovel2 / E:\workspace\webnovel，仓库之外。
    // 恢复基础策略里的询问，否则每次读正文/state.json 都要打断用户。
    { "action": "external_directory", "resource": "*", "effect": "ask" },
    { "action": "read", "resource": "*.env", "effect": "ask" },
    // SSOT：只能经 CLI 写入（chapter-commit 等）。deny 会把 edit/write/patch
    // 从模型可见集整体移除，比 write-guard.js 的运行时拒绝更靠前一层。
    { "action": "edit", "resource": "*.webnovel/state.json", "effect": "deny" },
    { "action": "edit", "resource": "*.webnovel/index.db", "effect": "deny" },
    { "action": "edit", "resource": "*.webnovel/vectors.db", "effect": "deny" },
    { "action": "edit", "resource": "*.webnovel/memory_scratchpad.json", "effect": "deny" },
    { "action": "edit", "resource": "*.story-system/events/*", "effect": "deny" },
    { "action": "edit", "resource": "*.story-system/master_setting.json", "effect": "deny" }
  ],

  // ⚠️ 显式关闭 formatter。V2 的内置 formatter 里 prettier / biome 都覆盖 .md，
  // 而本书 65 章正文全是 .md（正文/第1卷/第0001章-废墟中的觉醒.md …）。
  // 开启会把已发布正文重排折行、规范化标点空白——那是**改用户的作品**，
  // 且 formatter 是写盘**之后**才跑，属于事后动作，拦不住。
  // 本仓库的 .md 一律保持"人工排版即最终形态"。
  "formatter": false,

  // 长会话（连写多章 / 批量写作）的压缩策略。
  // V2 用摘要 + keep.tokens 取代 V1 的 tail_turns/prune（后两者在 V2 会被
  // 忽略并告警）。keep 调高是为了让刚写完那章的原文尽量逐字留在尾部——
  // 我们跨章依赖的是 .webnovel/state.json 与事件日志，但对话尾部仍决定
  // 下一章开头的连续性。
  "compaction": {
    "auto": true,
    "keep": { "tokens": 24000 },
    "buffer": 20000
  },

  // 大文件按需加载，别让 watcher 盯着。
  // .webnovel/ 下是 SQLite 与运行时产物，事件多时改动频繁且无意义。
  "watcher": {
    "ignore": [
      ".opencode/node_modules/**",
      ".opencode/dashboard/frontend/node_modules/**",
      ".opencode/dashboard/frontend/dist/**",
      ".tmp/**",
      ".pytest_cache/**",
      "**/__pycache__/**",
      "外部参考/**"
    ]
  },

  // 工具输出上限：默认 2000 行 / 51200 字节。CLI 输出（doctor、state render）
  // 可能很长，压低一点能少烧 context——但别太低，ssot verify 的差异报告要完整。
  "tool_output": {
    "max_lines": 2000,
    "max_bytes": 51200
  },

  // ⚠️ 故意**不**写 "instructions": [...]。
  // V2 文档明写："OpenCode accepts this field but does not load its entries;
  // use AGENTS.md for instructions." —— 它能通过校验、什么都不做，是静默空操作。
  // 项目说明的唯一真实通道是 AGENTS.md（由 dsh-sync 从 CLAUDE.md 镜像生成）。
  //
  // 同样不写 "skills"：V2 已自动发现 .opencode/skills/，配空数组没有意义。
}