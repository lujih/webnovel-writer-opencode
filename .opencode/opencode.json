{
  // ── OpenCode V2 原生配置 ─────────────────────────────────────────────
  //
  // 本项目自本次改动起**只支持 OpenCode 2**（破坏性变更，见下方「V1 兼容」）。
  // 键名全部采用 V2 原生形状，可对照 https://opencode.ai/config.json 校验。
  //
  // ⚠️ V1 兼容：V1（1.18.x）的配置 schema 是 additionalProperties:false，
  //    遇到顶层 `permissions` 会以 rc=1 **拒绝加载整份配置**（实测 opencode
  //    1.18.34 + `opencode debug config`）。因此从本版本开始：
  //      · OpenCode 2：完整支持（本文件即 V2 原生）
  //      · OpenCode 1：不再支持，请使用 v3.1.x 及更早版本
  //    需要同时兼容两代时，把 users 的 expectations 写进 README 而不是配置——
  //    配置只能有一份形状，混写会让其中一代直接起不来。
  "$schema": "https://opencode.ai/config.json",

  // SSOT 写保护的第一层。三层一起看：
  //   ① 本文件的顶层 permissions（V2 在权限判定最前端生效）
  //   ② .opencode/plugins/write-guard.js 的 tool.execute.before 运行时拦截
  //   ③ 6 个 .opencode/agents/*.md 各自的 permissions（子 agent 用**自己的**
  //      规则集，不是父集的子集）
  //
  // V2 语义：规则按顺序匹配，**最后命中者生效**；全局规则先于 agent 规则，
  // agent 规则追加在后面而不是替换。默认基线是 {*:*:allow} + .env 读 ask，
  // 所以这里的 deny 必须排在基线的 allow 之后——它们天然位于全局配置段，满足。
  "permissions": [
    { "action": "edit", "resource": "*.webnovel/state.json", "effect": "deny" },
    { "action": "edit", "resource": "*.webnovel/index.db", "effect": "deny" },
    { "action": "edit", "resource": "*.webnovel/vectors.db", "effect": "deny" },
    { "action": "edit", "resource": "*.webnovel/memory_scratchpad.json", "effect": "deny" },
    { "action": "edit", "resource": "*.story-system/events/", "effect": "deny" },
    { "action": "edit", "resource": "*.story-system/commits/", "effect": "deny" },
    { "action": "edit", "resource": "*.story-system/master_setting.json", "effect": "deny" },

    // V2 默认**允许**访问项目之外（V1 是 ask）。书项目通常在工具仓库之外
    // （E:\workspace\webnovel2 等），这里恢复 ask：能访问，但要经一次确认。
    // 见 https://opencode.ai/docs/permissions#directories
    { "action": "external_directory", "resource": "*", "effect": "ask" }
  ],

  // 显式关闭 formatter：V2 内置的 prettier/biome 都覆盖 .md，而本项目产物
  // 绝大多数是 .md（章节正文、设定集、skill 文档）。formatter 在写盘**之后**
  // 才跑，等于重排用户作品且拦不住。见 /docs/formatters。
  "formatter": false,

  // 长会话（连写多章）的压缩策略。V2 的 keep.tokens 取代 V1 的 tail_turns/prune；
  // buffer 是「模型窗口的预留比例」，可写 token 数或百分比（如 "15%"）。
  // 这里用 token 数：保留 24000 让刚写完那章的原文尽量逐字留在尾部。
  "compaction": {
    "auto": true,
    "keep": { "tokens": 24000 },
    "buffer": 20000
  },

  // 文件监听忽略项。`.webnovel/` 下是 SQLite 与运行时产物，事件多且无意义。
  "watcher": {
    "ignore": [
      ".opencode/node_modules/**",
      ".opencode/dashboard/frontend/node_modules/**",
      ".opencode/dashboard/frontend/dist/**",
      ".tmp/**",
      ".pytest_cache/**",
      "**/__pycache__/**",
      "外部参考/**"
    ]
  },

  // 工具输出上限：V2 文档的默认值，写出来只为在长输出时尽早暴露截断。
  "tool_output": {
    "max_lines": 2000,
    "max_bytes": 51200
  }

  // 说明：不使用以下键
  // · `instructions`：V2 **确实会加载**（/docs/config#instructions），本项目把
  //   规则放在 AGENTS.md 单一入口，暂不需要额外文件清单。
  // · `skills`：V2 自动发现 .opencode/skills/，无需声明。
  // · `agents` / `commands` / `plugins`：本项目用文件式定义
  //   （.opencode/agents/*.md、.opencode/commands/*.md、.opencode/plugins/*.js），
  //   文件式与 JSON 式共用同一注册表，二者取其一即可。
}
